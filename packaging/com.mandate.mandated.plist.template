<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mandate.mandated</string>
  <key>ProgramArguments</key>
  <array>
    <string>__APP__/Contents/MacOS/mandated</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>MANDATE_WEB_DIR</key><string>__APP__/Contents/Resources/dashboard</string>
    <key>MANDATE_PROVIDERS_DIR</key><string>__APP__/Contents/Resources/providers</string>
    <key>MANDATE_MCP_ENTRY</key><string>__APP__/Contents/Resources/mcp/dist/index.js</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/mandated.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/mandated.log</string>
</dict>
</plist>
